# Cloudflare KV access for the inbox API routes.
# Get these from the Cloudflare dashboard after following worker/SETUP.md.
# Until they are set, /api/inbox returns an empty inbox gracefully.

# Account ID — Cloudflare dashboard URL or Workers overview page
CLOUDFLARE_ACCOUNT_ID=

# KV namespace ID — output of `npx wrangler kv namespace create INBOX_KV`
CLOUDFLARE_KV_NAMESPACE_ID=

# API token with "Workers KV Storage: Read" permission (server-side only)
CLOUDFLARE_API_TOKEN=
